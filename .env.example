# Copy to .env in this directory. ikos_config.py loads that file.
# Do not commit .env.

# OpenRouter — answers and embeddings. Leave the key empty to boot the API
# without calling a model.
OPENROUTER_API_KEY=
LLAMA_CLOUD_API_KEY=
IKOS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
IKOS_OPENROUTER_MODEL=google/gemini-2.5-flash
IKOS_OPENROUTER_MODEL_SIMPLE=openai/gpt-4o-mini
IKOS_OPENROUTER_MODEL_COMPLEX=google/gemini-2.5-pro
IKOS_OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-large
IKOS_ENABLE_OPENROUTER_FALLBACK=true
IKOS_OPENROUTER_TIMEOUT_SECONDS=60

# PostgreSQL. Use a role that is not a superuser and does not have BYPASSRLS.
IKOS_DB_NAME=ikos_dev
IKOS_DB_HOST=127.0.0.1
IKOS_DB_USER=ikos_app
IKOS_DB_PASSWORD=
IKOS_DB_PORT=5432

# Qdrant. Query uses QDRANT_URL. Ingest uses IKOS_QDRANT_HOST and IKOS_QDRANT_PORT.
# The collection name that both paths read is QDRANT_COLLECTION.
# IKOS_QDRANT_COLLECTION is not read.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ikos_dev
IKOS_QDRANT_HOST=127.0.0.1
IKOS_QDRANT_PORT=6333
IKOS_QDRANT_EMBEDDING_MODEL=openai/text-embedding-3-large
IKOS_QDRANT_EMBEDDING_DIMENSION=3072

# Every API request, including /api/health, must send this value as
# X-IKOS-Auth-Secret. Generate a long random string.
IKOS_TRUSTED_AUTH_PROXY_SECRET=

# Comma-separated stable subjects allowed to provision tenants.
# Do not use email addresses.
IKOS_PLATFORM_ADMIN_SUBJECTS=

# Signed assertions from the external application (RS256).
# IKOS_INTEGRATION_JWT_PUBLIC_KEY_PATH=
# IKOS_INTEGRATION_JWT_PUBLIC_KEY_PEM=
IKOS_INTEGRATION_JWT_ISSUER=external-application
IKOS_INTEGRATION_JWT_AUDIENCE=ikos-api
IKOS_INTEGRATION_JWT_CLOCK_SKEW_SECONDS=30

# Optional trusted-server directory for platform-admin extension package imports.
# Keep this outside the web root and writable only by the deployment operator.
IKOS_EXTENSION_PACKAGE_INBOX=
